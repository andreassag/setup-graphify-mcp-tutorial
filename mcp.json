{
    "mcpServers": {
        "graphify": {
            "command": "docker",
            "args": [
                "compose",
                "--project-directory",
                ".",
                "-f",
                "/home/<user>/.mcp/graphify/docker-compose.yml",
                "run",
                "--rm",
                "-i",
                "-T",
                "graphify-mcp"
            ]
        }
    }
}
